  <property name="styleSheet">
   <string notr="true">/* Master Background */
QMainWindow {
    background-color: #050f05; /* Deep, dark green/black */
}

/* Panel Frames */
QFrame {
    background-color: #0a170a;
    border: 2px solid #1a4a1a;
    border-radius: 0px;
}

/* Typography and Labels */
QLabel {
    color: #4af626; /* Bright phosphor green */
    font-family: &quot;Consolas&quot;, &quot;Courier New&quot;, monospace;
    font-size: 14px;
    font-weight: bold;
    border: none; /* Removes border from text */
}

/* Terminal and Lists */
QTextEdit, QListWidget, QGraphicsView {
    background-color: #020502;
    color: #4af626;
    border: 1px solid #2a7a2a;
    font-family: &quot;Consolas&quot;, monospace;
}

/* Standard Buttons */
QPushButton {
    background-color: #1a4a1a;
    color: #4af626;
    border: 1px solid #4af626;
    font-family: &quot;Consolas&quot;, monospace;
    font-weight: bold;
    padding: 5px;
}
QPushButton:hover {
    background-color: #4af626;
    color: #000000;
}

/* The Emergency Stop Button */
QPushButton#pushButton_2 { /* Change this ID to match your E-Stop button's objectName! */
    background-color: #4a0a0a;
    color: #ff3333;
    border: 2px solid #ff3333;
}
QPushButton#pushButton_2:hover {
    background-color: #ff3333;
    color: #000000;
}

/* Reactor Core / Progress Bar */
QProgressBar {
    border: 1px solid #4af626;
    background-color: #020502;
    text-align: center;
    color: #4af626;
    font-weight: bold;
}
QProgressBar::chunk {
    background-color: #4af626;
    width: 10px; /* Creates that segmented, retro blocky look */
    margin: 1px;
}</string>
